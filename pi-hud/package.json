{
	"name": "@j4shu/pi-hud",
	"version": "0.1.0",
	"description": "A minimal, monochrome heads-up band for pi: square-bordered prompt with a CLI caret, plus a one-row statusline (cwd, git, model, tokens)",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"license": "MIT",
	"author": "j4shu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/j4shu/pi-extensions.git"
	},
	"homepage": "https://github.com/j4shu/pi-extensions/tree/main/pi-hud",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.6.0"
	},
	"scripts": {
		"check": "tsc",
		"test": "node --test src/tests/*.test.ts"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@earendil-works/pi-tui": "^0.85.1",
		"@types/node": "^26.0.0",
		"typescript": "^7.0.2"
	}
}
